# All optional. The site works without any of them.

# Address suggestions. Defaults to the free Photon service (OpenStreetMap data).
# Point this at a self-hosted Photon instance if traffic grows.
VITE_LOCATION_SEARCH_URL=

# Driving distance. Defaults to free OSRM routing on OpenStreetMap data.
VITE_ROUTING_URL=

# Google Routes API key: works out the driving distance with Google instead.
# Restrict it to your domain. Never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=
