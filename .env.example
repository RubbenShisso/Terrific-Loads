# Endpoint that receives quote form submissions as JSON, for example a Formspree form URL.
# Leave it empty and the form offers "send these details on WhatsApp" instead.
VITE_FORM_ENDPOINT=

# Quick Book (all optional; the booking flow works without them)
# Google Maps key with the Maps JavaScript API (Places) and Routes API enabled.
# Adds address autocomplete and works out road distance. Restrict it to your domain.
VITE_GOOGLE_MAPS_API_KEY=
# Where "Book This Delivery" saves bookings. Without one, bookings are sent on WhatsApp.
# Either Firestore (REST, no SDK)...
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
# ...or any endpoint that accepts JSON (falls back to VITE_FORM_ENDPOINT).
VITE_BOOKING_ENDPOINT=

# Address suggestions (optional). Defaults to the free Photon service (OpenStreetMap data).
# Point this at a self-hosted Photon instance if traffic grows.
VITE_LOCATION_SEARCH_URL=
